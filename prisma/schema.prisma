// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model telemetry {
  deviceId       String
  date           DateTime @db.Timestamptz(6)
  // Location fields
  latitude       Float?
  longitude      Float?
  speed          Float?
  accuracy       Float?
  altitude       Float?
  provider       String?
  timeToFix      Float?
  bearing        Float?
  // Battery fields
  voltage        Float?
  current        Float?
  temperature    Float?
  level          Float?
  charging       Boolean?
  // Sensors fields
  barometer      Float?
  light          Float?
  proximity      Float?
  // Cellular fields
  networkType    String?
  signalStrength Float?
  signalPower    Float?
  cellTower      String?

  device device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([date, deviceId])
}

model log {
  index   Int      @id @default(autoincrement())
  content String
  date    DateTime @db.Timestamptz(6)
  level   String
  session String
}

model device {
  id          String      @id
  name        String
  telemetries telemetry[]
}
